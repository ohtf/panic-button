#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Open Health Technology Foundation contributors
# SPDX-License-Identifier: AGPL-3.0-or-later WITH LicenseRef-PanicButton-app-store-exception
#
# Install Panic Button from this checkout.
#
#   s/install            the command-line programs (panic-button,
#                        panic-button-agent, panic-button-relay) into
#                        ~/.cargo/bin
#   s/install --desktop  those, plus the desktop app as a system package
#   s/install --user     those, plus the desktop app for your account only:
#                        ~/.local/bin/panic-button-desktop and a launcher
#                        entry, "Panic Button (from source)"; no sudo
#
# The desktop app is built as a deb and installed with the system's package
# manager, so it starts at sign-in, appears in the app menu and can be removed
# cleanly:
#
#   Arch and derivatives  package panic-button-git (wraps the deb with
#                         packaging/aur/PKGBUILD.in); remove with
#                         `sudo pacman -R panic-button-git`
#   Debian, Ubuntu        `sudo apt remove panic-button`
#   Fedora                built as an rpm; `sudo dnf remove panic-button`
#
# Running it again replaces the previous install. On Arch, if panic-button-bin
# from the AUR is installed, pacman asks before replacing it with
# panic-button-git.
#
# Remove a --user install with
#   rm ~/.local/bin/panic-button-desktop \
#      ~/.local/share/applications/panic-button-desktop.desktop \
#      ~/.local/share/icons/hicolor/*/apps/panic-button-desktop.*
#
# --desktop asks for your sudo password for the last step. Quit the running app (tray
# menu) and start it again afterwards to use the new build. Uncommitted
# changes are included in the build but not in the package version.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mode=cli
case "${1:-}" in
  "") ;;
  --desktop) mode=desktop ;;
  --user) mode=user ;;
  *) echo "usage: s/install [--desktop | --user]" >&2; exit 2 ;;
esac

command -v cargo >/dev/null || { echo "cargo not found: install Rust from https://rustup.rs" >&2; exit 1; }

# --force: replace whatever is installed under these names, including the
# separate panic-button-agent and panic-button-relay packages from before
# version 0.2.0.
cargo install --locked --force --target-dir target --path crates/panic-button
[[ $mode == cli ]] && exit 0

system=other
if command -v pacman >/dev/null; then
  system=arch
elif command -v apt-get >/dev/null; then
  system=debian
elif command -v dnf >/dev/null; then
  system=fedora
fi
if [[ $mode == desktop && $system == other ]]; then
  echo "s/install --desktop knows pacman, apt and dnf. Elsewhere, use s/install --user, or build the AppImage and run it:" >&2
  echo "  (cd apps/desktop && npx tauri build --bundles appimage)" >&2
  exit 1
fi

command -v npm >/dev/null || { echo "npm not found: install Node.js 24 (https://nodejs.org)" >&2; exit 1; }
if ! pkg-config --exists webkit2gtk-4.1 libsoup-3.0 alsa 2>/dev/null; then
  echo "The desktop app needs WebKitGTK 4.1, libsoup 3 and ALSA development files:" >&2
  case $system in
    arch) echo "  sudo pacman -S --needed webkit2gtk-4.1 libsoup3 alsa-lib libayatana-appindicator librsvg" >&2 ;;
    debian) echo "  sudo apt install libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev libasound2-dev" >&2 ;;
    fedora) echo "  sudo dnf install webkit2gtk4.1-devel libayatana-appindicator-gtk3-devel librsvg2-devel alsa-lib-devel" >&2 ;;
    other) echo "  (docs/gui/README.md lists the Debian package names)" >&2 ;;
  esac
  exit 1
fi

if [[ $mode == user ]]; then
  (cd apps/desktop && { [[ -d node_modules ]] || npm ci; } && npx tauri build --no-bundle)
  share="${XDG_DATA_HOME:-$HOME/.local/share}"
  bin="$HOME/.local/bin/panic-button-desktop"
  icons=apps/desktop/src-tauri/icons
  install -Dm755 target/release/panic-button-desktop "$bin"
  install -Dm644 docs/assets/panic-button-logo.svg "$share/icons/hicolor/scalable/apps/panic-button-desktop.svg"
  install -Dm644 "$icons/128x128.png" "$share/icons/hicolor/128x128/apps/panic-button-desktop.png"
  install -Dm644 "$icons/32x32.png" "$share/icons/hicolor/32x32/apps/panic-button-desktop.png"
  # Named after the window's app ID, so docks and taskbars match the running
  # window to this entry.
  entry="$share/applications/panic-button-desktop.desktop"
  mkdir -p "$(dirname "$entry")"
  cat > "$entry" <<ENTRY
[Desktop Entry]
Type=Application
Name=Panic Button (from source)
Comment=Call colleagues for help from this computer. Built from $(git describe --tags --always --dirty) on $(date +%F).
Exec=$bin
Icon=panic-button-desktop
StartupWMClass=panic-button-desktop
Categories=Utility;
Terminal=false
ENTRY
  if command -v update-desktop-database >/dev/null; then
    update-desktop-database "$share/applications" || true
  fi
  echo "Installed $bin and the launcher entry \"Panic Button (from source)\"."
  echo "If Panic Button is running, quit it from the tray and start it again to use this build."
  exit 0
fi

version="$(awk -F\" '/^version = / {print $2; exit}' Cargo.toml)"
bundle=target/release/bundle
bundles=deb
[[ $system == fedora ]] && bundles=rpm
(cd apps/desktop && { [[ -d node_modules ]] || npm ci; } && npx tauri build --bundles "$bundles")

case $system in
  arch)
    command -v makepkg >/dev/null || { echo "makepkg not found: sudo pacman -S --needed base-devel" >&2; exit 1; }
    pkgver="${version}.r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
    build=target/install/arch
    rm -rf "$build"
    mkdir -p "$build"
    cp "$bundle/deb/Panic Button_${version}_amd64.deb" "$build/panic-button-desktop_${pkgver}_amd64.deb"
    cp LICENSE-EXCEPTIONS.md "$build/LICENSE-EXCEPTIONS-${pkgver}.md"
    cp packaging/aur/panic-button.install "$build/"
    # makepkg uses source files already in the build folder instead of
    # downloading them, so the release URLs in the template are never fetched.
    sed -e "s/^pkgname=panic-button-bin$/pkgname=panic-button-git/" \
        -e "s/@VERSION@/${pkgver}/" \
        -e "s/@DEB_SHA256@/$(sha256sum "$build/panic-button-desktop_${pkgver}_amd64.deb" | cut -d' ' -f1)/" \
        -e "s/@EXCEPTION_SHA256@/$(sha256sum LICENSE-EXCEPTIONS.md | cut -d' ' -f1)/" \
        packaging/aur/PKGBUILD.in > "$build/PKGBUILD"
    grep -q '^pkgname=panic-button-git$' "$build/PKGBUILD"
    (cd "$build" && makepkg -f -d --noconfirm)
    exec sudo pacman -U "$build/panic-button-git-${pkgver}-1-x86_64.pkg.tar.zst"
    ;;
  debian)
    exec sudo apt-get install --reinstall "$PWD/$bundle/deb/Panic Button_${version}_amd64.deb"
    ;;
  fedora)
    rpm="$PWD/$bundle/rpm/Panic Button-${version}-1.x86_64.rpm"
    if rpm -q panic-button >/dev/null 2>&1; then
      exec sudo dnf reinstall "$rpm"
    fi
    exec sudo dnf install "$rpm"
    ;;
esac
