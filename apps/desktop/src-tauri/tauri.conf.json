{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panic Button",
  "mainBinaryName": "panic-button-desktop",
  "identifier": "org.ohtf.panic-button",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Call colleagues for help from this computer",
    "copyright": "Open Health Technology Foundation contributors",
    "license": "AGPL-3.0-or-later WITH LicenseRef-PanicButton-app-store-exception",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "3b23abe3-14bd-403a-8514-62b4a749fc51",
        "fragmentPaths": [
          "../../../packaging/windows/panic-button.wxs"
        ],
        "componentRefs": [
          "PanicButtonAutostart"
        ]
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/panic-button-desktop.desktop": "../../../packaging/linux/panic-button-autostart.desktop",
          "/usr/lib/systemd/user/panic-button-watchdog.service": "../../../packaging/linux/panic-button-watchdog.service",
          "/usr/lib/systemd/user/panic-button-watchdog.timer": "../../../packaging/linux/panic-button-watchdog.timer",
          "/usr/share/applications/org.ohtf.panic-button.desktop": "../../../packaging/linux/org.ohtf.panic-button.desktop"
        },
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "postInstallScript": "../../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../../packaging/linux/prerm.sh"
      },
      "rpm": {
        "files": {
          "/etc/xdg/autostart/panic-button-desktop.desktop": "../../../packaging/linux/panic-button-autostart.desktop",
          "/usr/lib/systemd/user/panic-button-watchdog.service": "../../../packaging/linux/panic-button-watchdog.service",
          "/usr/lib/systemd/user/panic-button-watchdog.timer": "../../../packaging/linux/panic-button-watchdog.timer",
          "/usr/share/applications/org.ohtf.panic-button.desktop": "../../../packaging/linux/org.ohtf.panic-button.desktop"
        },
        "postInstallScript": "../../../packaging/linux/postinst.sh",
        "preRemoveScript": "../../../packaging/linux/prerm.sh"
      }
    }
  }
}
